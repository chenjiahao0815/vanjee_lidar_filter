Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Cell Size: 1
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.45
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Enabled: true
      Name: RawLidar
      Size (m): 0.04
      Style: Cubes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/lidar
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: FilterVerdict
      Size (m): 0.04
      Style: Cubes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/filter_verdict
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: FilterBoxes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/filter_boxes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: OccupiedVoxels
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/voxel_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: DeletedVoxels
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/voxel_markers_deleted
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: KeptVoxels
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/voxel_markers_kept
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: KeptCloud
      Size (m): 0.04
      Style: Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/lidar_passthrough
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 184; 56; 242
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: RemovedCloud
      Size (m): 0.05
      Style: Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vanjee/lidar_removed
      Use Fixed Frame: true
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: vanjee_lidar_link
    Frame Rate: 30
    Use Sim Time: false
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.5
      Name: Current View
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Yaw: 0.9
    Saved: ~
